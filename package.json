{
  "name": "malmstone-calculator",
  "version": "0.0.0",
  "description": "This application will help calculate how many PvP matches are required to achieve a given Malmstone level, with support for multiple characters.",
  "main": "index.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "lint": "npx eslint && npx prettier . --check",
    "clean": "npx eslint --fix && npx prettier . --write",
    "test": "ng test",
    "prepare": "husky install"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.28",
    "@angular/common": "^20.3.28",
    "@angular/compiler": "^20.3.28",
    "@angular/core": "^20.3.28",
    "@angular/forms": "^20.3.28",
    "@angular/platform-browser": "^20.3.28",
    "@angular/platform-browser-dynamic": "^20.3.28",
    "@angular/router": "^20.3.28",
    "ngx-google-analytics": "^14.0.1",
    "normalize.css": "^8.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.34",
    "@angular/cli": "^20.3.34",
    "@angular/compiler-cli": "^20.3.28",
    "@eslint/js": "^9.17.0",
    "@types/jasmine": "~5.1.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "lint-staged": "^15.3.0",
    "prettier": "3.4.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.19.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RedDwarfian/malmstone-calculator.git"
  },
  "keywords": [
    "FFXIV",
    "Malmstone",
    "PvP"
  ],
  "author": "RedDwarfian",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/RedDwarfian/malmstone-calculator/issues"
  },
  "homepage": "https://github.com/RedDwarfian/malmstone-calculator#readme",
  "lint-staged": {
    "!(*.ts)": "prettier --write",
    "*.ts": [
      "eslint --cache --fix",
      "prettier --write"
    ]
  },
  "allowScripts": {
    "esbuild@0.24.0": true,
    "@parcel/watcher@2.5.0": true,
    "fsevents@2.3.3": true,
    "lmdb@3.1.5": true
  }
}
